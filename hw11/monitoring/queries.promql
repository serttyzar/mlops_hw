# All durations are seconds. Labels pod and namespace come from Pod discovery.
# Completed successful responses only; preserve le across bucket aggregation.
histogram_quantile(0.95, sum by (le, pod) (rate(hw11_ttfc_seconds_bucket[1m])))
histogram_quantile(0.50, sum by (le) (rate(hw11_ttfc_seconds_bucket[1m])))
histogram_quantile(0.95, sum by (le, pod) (rate(hw11_response_seconds_bucket[1m])))
sum by (pod) (rate(hw11_requests_total{outcome="completed"}[1m]))
sum by (pod, outcome) (rate(hw11_requests_total{outcome=~"rejected|aborted"}[1m]))
hw11_running
hw11_waiting
sum by (pod) (rate(container_cpu_usage_seconds_total{namespace="hw11",container="api"}[1m]))
sum by (pod) (container_memory_working_set_bytes{namespace="hw11",container="api"})
sum(kube_pod_status_ready{namespace="hw11",pod=~"hw11-api-.*",condition="true"})
# Run-specific analysis, set range to actual run including its completion tail.
# Script additionally subtracts two raw counter snapshots on an unchanged Pod
# cohort to avoid rate/increase extrapolation and require equal success counts.
histogram_quantile(0.95, sum by (le, pod) (increase(hw11_ttfc_seconds_bucket[150s])))
