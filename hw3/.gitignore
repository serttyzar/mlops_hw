__pycache__/
.venv/
dvc_remote/

# Данные версионирует DVC, а не git. В репозиторий едут только .dvc-указатели
# и dvc.lock. Без этой строки первый же `git add .` кладёт в историю весь
# data/, и дальше он оттуда не вычищается без перезаписи истории.
data/

# Мусор, который иначе доезжает до ревью.
.DS_Store
*.bak
*.orig
